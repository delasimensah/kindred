{
  "name": "kindred",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "**/react-native",
      "**/react-native/**"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@kindred/mobile-app",
    "dev:web": "turbo run dev --filter=@kindred/web-app",
    "dev:apps": "turbo run dev --filter=@kindred/mobile-app --filter=@kindred/web-app",
    "dev:backend": "convex dev",
    "dev:backend:once": "convex dev --once",
    "deploy:backend": "convex deploy",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "yarn type-check:backend && turbo run type-check",
    "type-check:backend": "tsc --noEmit -p convex/tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "test": "yarn test:backend && turbo run test",
    "test:ci": "yarn test:backend && turbo run test:ci",
    "test:backend": "vitest run --config vitest.config.ts",
    "test:mobile": "turbo run test --filter=@kindred/mobile-app",
    "test:web": "turbo run test --filter=@kindred/web-app",
    "test:shared": "turbo run test --filter=shared",
    "clean": "turbo run clean && rm -rf node_modules",
    "seed:assets": "node seed/scripts/fetch-assets.mjs",
    "seed:shrink": "node seed/scripts/shrink-audio.mjs",
    "seed:apply-shrunk": "node seed/scripts/apply-shrunk-audio.mjs",
    "seed:catalog": "node seed/scripts/run-seed.mjs",
    "postinstall": "patch-package && node scripts/apply-nested-patches.mjs"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22",
    "convex-test": "^0.0.56",
    "ffmpeg-static": "^5.3.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "turbo": "^2.10.11",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.124"
  },
  "resolutions": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@react-native/jest-preset": "0.86.3"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "yarn": ">=1.22.0",
    "node": ">=22.13.0"
  }
}
